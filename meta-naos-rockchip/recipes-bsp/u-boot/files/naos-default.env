# Complete default environment: no inherited Android A/B or bootflow command.
baudrate=1500000
bootdelay=3
stdin=serial
stdout=serial
stderr=serial
bootcmd=run naos_boot
devtype=mmc
BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=3
fit_addr_r=0x10000000
kernel_addr_r=0x00400000
fdt_addr_r=0x08300000
ramdisk_addr_r=0x0a200000
kernel_comp_addr_r=0x05480000
kernel_comp_size=0x04000000
naos_console=earlycon=uart8250,mmio32,0xfeb50000 console=ttyFIQ0,1500000n8 irqchip.gicv3_pseudo_nmi=0 panic=3 rcupdate.rcu_expedited=1 rcu_nocbs=all
naos_try_a=if itest "${BOOT_A_LEFT}" -gt 0; then setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; setenv naos_slot A; setenv naos_bootpart boot_a; setenv naos_systempart system_a; run naos_load; fi
naos_try_b=if itest "${BOOT_B_LEFT}" -gt 0; then setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; setenv naos_slot B; setenv naos_bootpart boot_b; setenv naos_systempart system_b; run naos_load; fi
naos_load=if saveenv; then if part start mmc ${naos_mmcdev} ${naos_bootpart} naos_start && part size mmc ${naos_mmcdev} ${naos_bootpart} naos_size && part number mmc ${naos_mmcdev} ${naos_systempart} naos_systemnum && part uuid mmc ${naos_mmcdev}:${naos_systemnum} naos_systemuuid; then if mmc read ${fit_addr_r} ${naos_start} ${naos_size}; then setenv bootargs ${naos_console} rdinit=/init rauc.slot=${naos_slot} naos.slot=${naos_slot} naos.system=PARTUUID=${naos_systemuuid}; bootm ${fit_addr_r}#conf ${fit_addr_r}#conf ${fit_addr_r}#conf; fi; fi; else echo NAOS cannot persist the boot attempt; fi
naos_boot=if naos_bootdev && mmc dev ${naos_mmcdev}; then for naos_candidate in ${BOOT_ORDER}; do if test "${naos_candidate}" = A; then run naos_try_a; elif test "${naos_candidate}" = B; then run naos_try_b; fi; done; echo NAOS no bootable slot remains - use Rockchip USB recovery; else echo NAOS boot MMC is unavailable; fi
