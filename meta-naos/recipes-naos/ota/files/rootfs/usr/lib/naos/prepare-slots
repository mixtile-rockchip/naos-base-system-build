#!/bin/sh
set -eu
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
. /usr/lib/naos/storage.sh
[ -r /run/naos/boot-device ] && [ -r /run/naos/slot ] || {
    echo "NAOS: boot-device/slot metadata from initramfs is missing" >&2
    exit 1
}
IFS= read -r disk </run/naos/boot-device
IFS= read -r slot </run/naos/slot
case "$disk" in /dev/*) ;; *) exit 1 ;; esac
case "$slot" in A) system_label=system_a ;; B) system_label=system_b ;; *) exit 1 ;; esac
cmd_slot=
cmd_rauc_slot=
cmd_board=
slot_seen=0
rauc_slot_seen=0
board_seen=0
set -f
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        naos.slot=*) [ "$slot_seen" -eq 0 ]; slot_seen=1; cmd_slot=${arg#naos.slot=} ;;
        rauc.slot=*) [ "$rauc_slot_seen" -eq 0 ]; rauc_slot_seen=1; cmd_rauc_slot=${arg#rauc.slot=} ;;
        naos.board=*) [ "$board_seen" -eq 0 ]; board_seen=1; cmd_board=${arg#naos.board=} ;;
    esac
done
set +f
[ "$slot" = "$cmd_slot" ] && [ "$slot" = "$cmd_rauc_slot" ] || exit 1
if [ "$board_seen" -eq 1 ]; then
    [ "$cmd_board" = radxa-airbox-q900 ]
    IFS= read -r board </run/naos/board
    [ "$board" = "$cmd_board" ]
    layout=$(naos_q900_layout_compatible)
    case "$layout" in
        *-crypt) encrypted_userdata=1 ;;
        *) encrypted_userdata=0 ;;
    esac
    naos_bind_disk_parts "$disk" "$board" "$encrypted_userdata"
    IFS= read -r system </run/naos/system-device
    [ "$(readlink -f "/dev/naos/$system_label")" = "$system" ]
    system_mount=$system
    case "$layout" in
        *-disk-crypt) system_mount=$(naos_system_mapper_for_raw "$system") ;;
    esac
    naos_require_block_mount /run/naos/lower squashfs ro "$system_mount"
    naos_q900_system_matches_layout /run/naos/lower "$layout"
    for data_mount in /run/naos/data /userdata; do
        naos_require_block_mount "$data_mount" f2fs rw /dev/naos/userdata
    done
    exit 0
else
    [ ! -e /run/naos/board ]
fi
naos_bind_disk_parts "$disk" "$cmd_board"
IFS= read -r system </run/naos/system-device
[ "$(readlink -f "/dev/naos/$system_label")" = "$system" ]
lower_source=$(awk '$2 == "/run/naos/lower" && $3 == "squashfs" { print $1 }' /proc/mounts)
[ -n "$lower_source" ] && [ "$(readlink -f "$lower_source")" = "$system" ] || exit 1
for data_mount in /run/naos/data /userdata; do
    userdata_source=$(awk -v point="$data_mount" '$5 == point && $4 == "/" && $6 ~ /(^|,)rw(,|$)/ {
        for (i = 6; i <= NF; i++)
            if ($i == "-" && $(i + 1) == "f2fs") print $(i + 2)
    }' /proc/self/mountinfo)
    [ -n "$userdata_source" ] && \
        [ "$(readlink -f "$userdata_source")" = "$(readlink -f /dev/naos/userdata)" ]
done
